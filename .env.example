# Copy to .env — never commit real secrets

# Required for app + Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — min 16 chars
NEXTAUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Notifications (required when sending email/SMS in production)
RESEND_API_KEY=""
# Optional — verified sender in Resend (defaults to onboarding@resend.dev for dev)
RESEND_FROM=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Optional — billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional — OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Optional — secured cron (manual runs); Vercel Cron uses x-vercel-cron when deployed on Vercel
INTERNAL_CRON_SECRET=""

# CI / local builds without full env
# SKIP_ENV_VALIDATION=1
